//- The search page (plugin-search): a standard page whose body is the
//- plugin's interface. The page header brings the page's one <h1>
//- (`show_title: false` in config/search.yaml); the plugin's script is added
//- by the scripts-extra.pug seam on this page only.
extends /layouts/layout.pug

block main
    include /partials/page-header.pug
    .page__body
        != content
        include /vendor/plugin-search/search.pug
