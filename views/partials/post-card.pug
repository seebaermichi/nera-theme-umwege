//- One post in a list (§S4.1a, §S11.5, Umwege). In scope: `item` (the post,
//- { content, meta }), `position` (its place in the list) and `featured`
//- (true for the first, wide card on the home). A post with a frontmatter
//- `image` shows it through the card-media seam with its `location` as a
//- chip on the picture; then the title, the description and the first
//- three `facts` values as chips. Cards carry no date, as the reference.
li.post-list__item
    article.post-card(class=(typeof featured !== 'undefined' && featured) ? 'post-card--featured' : undefined)
        if item.meta.image
            .post-card__media
                include card-media.pug
                if item.meta.location
                    span.post-card__location
                        svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' focusable='false')
                            path(d='M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21Z')
                            circle(cx='12' cy='9.5' r='2.4')
                        | #{item.meta.location}
        .post-card__body
            if !item.meta.image && item.meta.location
                span.post-card__location= item.meta.location
            h3.post-card__title
                a.post-card__link(href=item.meta.href)= item.meta.title
            if item.meta.description
                p.post-card__excerpt= item.meta.description
            if themeUmwege.facts(item).length
                ul.post-card__facts
                    each fact in themeUmwege.facts(item).slice(0, 3)
                        li= fact.value
