//- One post (§S4.1, §S11.7, Ansitz): the header (series line, the author
//- line with published and updated, title, lead, and location and
//- image_note on the right), lying on the post-media seam when the post has
//- an `image`; the body; its `facts` as a row of figures after the text;
//- then the post-tags seam, the parts of its series and the post-pagination
//- seam.
extends ../layouts/layout.pug

block main
    article.post
        header.post__header
            div
                if meta.series && themeUmwege.seriesParts(meta.series, pageLang({ meta })).length
                    p.post__series
                        | #{t('Series')}: #{meta.series}
                        if meta.series_part !== undefined && meta.series_part !== null && meta.series_part !== ''
                            | #{' · '}#{t('Part')} #{meta.series_part}
                p.post__meta
                    if meta.author || themeUmwege.author(pageLang({ meta })).name
                        span.post-author
                            span.post-author__mark(aria-hidden='true')= themeUmwege.initials(meta.author || themeUmwege.author(pageLang({ meta })).name)
                            span.post__author.post-author__name= meta.author || themeUmwege.author(pageLang({ meta })).name
                    if isoDate(meta.createdAt)
                        span
                            | #{t('Published')}#{' '}
                            time.post__date(datetime=isoDate(meta.createdAt))= formatDate(meta.createdAt, pageLang({ meta }))
                    if isoDate(meta.updated)
                        span
                            | #{t('Updated')}#{' '}
                            time.post__updated(datetime=isoDate(meta.updated))= formatDate(meta.updated, pageLang({ meta }))
                h1.post__title= meta.title || app.name
                if meta.lead
                    p.post__lead= meta.lead
            if meta.location || meta.image_note
                div
                    if meta.location
                        p.post__location= meta.location
                    if meta.image_note
                        p.post__image-note= meta.image_note
        if meta.image
            .post__media
                include ../partials/post-media.pug
        .post__body
            != content
        if themeUmwege.facts({ meta }).length
            dl.post-facts
                each fact in themeUmwege.facts({ meta })
                    .post-facts__item
                        dt.post-facts__label= fact.label
                        dd.post-facts__value= fact.value
        footer.post__footer
            .post__tags
                include ../partials/post-tags.pug
            if meta.series && themeUmwege.seriesParts(meta.series, pageLang({ meta })).length
                nav.post-series(aria-label=t('Series'))
                    h2.post-series__title= meta.series
                    ol.post-series__list
                        each part, index in themeUmwege.seriesParts(meta.series, pageLang({ meta }))
                            if part.meta.href === meta.href
                                li.post-series__item.post-series__item--current
                                    span= String(index + 1).padStart(2, '0')
                                    a(href=part.meta.href aria-current='page')= part.meta.title
                            else
                                li.post-series__item
                                    span= String(index + 1).padStart(2, '0')
                                    a(href=part.meta.href)= part.meta.title
            .post__pagination
                include ../partials/post-pagination.pug
